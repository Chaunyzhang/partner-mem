{
  "name": "partner-mem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && mkdir -p dist/storage/migrations && cp src/storage/migrations/*.sql dist/storage/migrations/",
    "build:hermes-plugin": "corepack pnpm build && node scripts/build-hermes-plugin.mjs",
    "test": "vitest run",
    "test:hermes-package": "vitest run test/integrations/hermes-package.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@photostructure/sqlite": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@11.5.2"
}
